#!/usr/bin/env bash
# Update IPTV Manager in place from its git repository (installed by proxmox/install.sh).
#
#   iptv-manager-update                  fetch and apply the latest version, if there is one
#   iptv-manager-update --check          only report whether an update is available
#   iptv-manager-update --force          reinstall and restart even when already up to date
#   iptv-manager-update --status         show the installed version and auto-update state
#   iptv-manager-update --enable-auto [HH:MM]   update automatically every night (default 04:00)
#   iptv-manager-update --disable-auto   turn nightly updates off
#   iptv-manager-update --setup          (re)install the systemd units, incl. the web "Update now" hook
#
# From the Proxmox host:  pct exec <container id> -- iptv-manager-update
#
# If the new version does not answer its health check within ~30 seconds, the previous
# version is restored and restarted, so a bad update never leaves the service down.
#
# The web interface cannot update anything itself (it runs unprivileged). Its "Update now"
# button writes $DATA_DIR/update/request; a systemd path unit notices the file and runs this
# script as root, which reports progress in $DATA_DIR/update/status.json and last.log.
set -euo pipefail

APP_DIR="${APP_DIR:-/opt/iptv-manager}"
CONF="${CONF:-/etc/default/iptv-manager}"
SYSTEMD_DIR="${SYSTEMD_DIR:-/etc/systemd/system}"
LOCK_FILE="${LOCK_FILE:-/run/lock/iptv-manager-update.lock}"
HEALTH_TRIES="${HEALTH_TRIES:-30}"
SERVICE=iptv-manager
SERVICE_USER=iptvm
TIMER=iptv-manager-update.timer
UPDATE_UNIT=iptv-manager-update.service
PATH_UNIT=iptv-manager-update.path

export LANG=C.UTF-8 LC_ALL=C.UTF-8

REPORTING=0    # set while an update runs, so failures land in status.json too
LOGFILE=""

log() {
  echo "[iptv-manager-update] $*"
  [ -z "$LOGFILE" ] || echo "$(date '+%H:%M:%S') $*" >> "$LOGFILE"
}
die() {
  echo "[iptv-manager-update] error: $*" >&2
  [ -z "$LOGFILE" ] || echo "$(date '+%H:%M:%S') error: $*" >> "$LOGFILE"
  [ "$REPORTING" = 1 ] && report "${FAIL_STATE:-failed}" "$*"
  exit 1
}

load_conf() {
  # shellcheck disable=SC1090
  [ -f "$CONF" ] && . "$CONF"
  PORT="${PORT:-8080}"
  BRANCH="${IPTV_BRANCH:-main}"
  DATA_DIR="${DATA_DIR:-/var/lib/iptv-manager}"
  UPDATE_DIR="$DATA_DIR/update"
}

json_str() {
  local s="${1//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/ }"
  printf '"%s"' "${s//$'\t'/ }"
}

# Progress for the web interface: state is running, updated, current, skipped, rolled_back or failed.
report() {
  mkdir -p "$UPDATE_DIR"
  local tmp="$UPDATE_DIR/status.json.tmp" now
  now="$(date +%s)"
  {
    printf '{"state":%s,"message":%s,"trigger":%s,"started_at":%s,' \
      "$(json_str "$1")" "$(json_str "$2")" "$(json_str "${TRIGGER:-manual}")" "${STARTED_AT:-$now}"
    printf '"finished_at":%s,"from":%s,"to":%s}\n' \
      "$([ "$1" = running ] && echo null || echo "$now")" "$(json_str "${OLD:-}")" "$(json_str "${NEW:-}")"
  } > "$tmp"
  mv -f "$tmp" "$UPDATE_DIR/status.json"
  chown "$SERVICE_USER:$SERVICE_USER" "$UPDATE_DIR/status.json" 2>/dev/null || true
}

describe() { git -C "$APP_DIR" log -1 --format='%h %s (%cd)' --date=short "${1:-HEAD}"; }

healthy() {
  local i
  for ((i = 0; i < HEALTH_TRIES; i++)); do
    curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:$PORT/healthz" && return 0
    sleep 1
  done
  return 1
}

deps() {
  # npm ci only when the lockfile changed (or dependencies are missing): updates stay fast.
  if [ "$1" != "$2" ] || [ ! -d "$APP_DIR/node_modules" ]; then
    log "Installing dependencies"
    (cd "$APP_DIR" && npm ci --omit=dev --no-audit --no-fund --loglevel=error)
  fi
}

fetch() {
  [ -d "$APP_DIR/.git" ] || die "$APP_DIR is not a git checkout. Re-run proxmox/install.sh once to convert it."
  git -C "$APP_DIR" fetch --quiet --depth 1 origin "$BRANCH" || die "could not reach $(git -C "$APP_DIR" remote get-url origin)"
  OLD="$(git -C "$APP_DIR" rev-parse HEAD)"
  NEW="$(git -C "$APP_DIR" rev-parse FETCH_HEAD)"
}

update() {
  local force="$1"
  if command -v flock >/dev/null; then
    exec 9>"$LOCK_FILE"
    # The run already in progress owns status.json; just step aside.
    flock -n 9 || { log "Another update is already running"; exit 0; }
  fi
  # A request from the web interface is consumed first, so the path unit does not fire again.
  TRIGGER=manual
  if [ -e "$UPDATE_DIR/request" ]; then
    TRIGGER=web
    rm -f "$UPDATE_DIR/request"
  elif [ -n "${INVOCATION_ID:-}" ]; then
    TRIGGER=scheduled
  fi
  STARTED_AT="$(date +%s)"
  mkdir -p "$UPDATE_DIR"
  LOGFILE="$UPDATE_DIR/last.log"
  : > "$LOGFILE"
  chown "$SERVICE_USER:$SERVICE_USER" "$LOGFILE" 2>/dev/null || true
  REPORTING=1
  report running "Checking for a new version"

  fetch
  if [ "$OLD" = "$NEW" ] && [ "$force" != 1 ]; then
    log "Already up to date: $(describe)"
    report current "Already up to date"
    return 0
  fi
  # A release that already failed its health check is not retried every night.
  local bad_file="$APP_DIR/.git/iptv-manager-failed-release"
  if [ "$force" != 1 ] && [ -f "$bad_file" ] && [ "$(cat "$bad_file")" = "$NEW" ]; then
    log "Skipping $(describe "$NEW"): it failed to start last time. Retry with --force."
    report skipped "The latest version failed to start last time, so it was skipped"
    return 0
  fi
  local old_lock new_lock
  old_lock="$(git -C "$APP_DIR" rev-parse "$OLD:package-lock.json")"
  new_lock="$(git -C "$APP_DIR" rev-parse "$NEW:package-lock.json")"
  [ "$OLD" = "$NEW" ] || log "Updating $(describe "$OLD")"
  log "        to $(describe "$NEW")"
  report running "Installing $(git -C "$APP_DIR" log -1 --format=%h "$NEW")"
  git -C "$APP_DIR" reset --quiet --hard "$NEW"
  if [ "$force" = 1 ]; then deps "" "$new_lock"; else deps "$old_lock" "$new_lock"; fi
  log "Restarting"
  report running "Restarting the app"
  systemctl restart "$SERVICE"
  if healthy; then
    rm -f "$bad_file"
    log "Updated and running: $(describe)"
    # Let the new version install any changes to its own systemd units.
    bash "$APP_DIR/proxmox/iptv-manager-update" --setup >/dev/null 2>&1 || log "warning: --setup of the new version failed"
    report updated "Updated to $(describe)"
    return 0
  fi
  echo "$NEW" > "$bad_file"
  log "The new version did not start; restoring ${OLD:0:7}"
  git -C "$APP_DIR" reset --quiet --hard "$OLD"
  deps "$new_lock" "$old_lock"
  systemctl restart "$SERVICE"
  if healthy; then
    FAIL_STATE=rolled_back die "the new version did not start, so it was rolled back; still running $(describe). See: journalctl -u $SERVICE"
  fi
  die "the rollback did not start either. See: journalctl -u $SERVICE"
}

check() {
  fetch
  if [ "$OLD" = "$NEW" ]; then
    log "Up to date: $(describe)"
  else
    log "Update available:"
    log "  installed $(describe "$OLD")"
    log "  latest    $(describe "$NEW")"
  fi
}

# Write a unit only when its content changed; echo "changed" if it did.
write_unit() {
  local file="$SYSTEMD_DIR/$1" content="$2"
  if [ ! -f "$file" ] || [ "$(cat "$file")" != "$content" ]; then
    printf '%s\n' "$content" > "$file"
    echo changed
  fi
}

# Idempotent: runs at the start of every invocation, so older installs gain new units.
setup() {
  mkdir -p "$SYSTEMD_DIR" "$UPDATE_DIR"
  chown "$SERVICE_USER:$SERVICE_USER" "$UPDATE_DIR" 2>/dev/null || true
  local changed=""
  changed+="$(write_unit "$UPDATE_UNIT" "[Unit]
Description=Update IPTV Manager from its git repository
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/bin/iptv-manager-update")"
  # The timer is installed disabled; --enable-auto turns it on and sets its time.
  changed+="$(write_unit "$TIMER" "[Unit]
Description=Nightly IPTV Manager update

[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target")"
  changed+="$(write_unit "$PATH_UNIT" "[Unit]
Description=Run IPTV Manager updates requested from its web interface

[Path]
PathExists=$UPDATE_DIR/request
Unit=$UPDATE_UNIT

[Install]
WantedBy=multi-user.target")"
  if [ -n "$changed" ]; then
    systemctl daemon-reload
  fi
  if ! systemctl is-enabled "$PATH_UNIT" >/dev/null 2>&1 || [ -n "$changed" ]; then
    systemctl enable --now "$PATH_UNIT" >/dev/null 2>&1 || log "warning: could not enable $PATH_UNIT"
  fi
  write_auto_state
}

enable_auto() {
  local at="${1:-04:00}"
  [[ "$at" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "time must be HH:MM (24-hour), e.g. 04:00"
  mkdir -p "$SYSTEMD_DIR/$TIMER.d"
  printf '[Timer]\nOnCalendar=\nOnCalendar=*-*-* %s:00\n' "$at" > "$SYSTEMD_DIR/$TIMER.d/schedule.conf"
  systemctl daemon-reload
  systemctl enable --now "$TIMER" >/dev/null 2>&1
  log "Nightly updates enabled at $at (plus up to 30 minutes of random delay)"
  write_auto_state
}

disable_auto() {
  systemctl disable --now "$TIMER" >/dev/null 2>&1 || true
  log "Nightly updates disabled"
  write_auto_state
}

# Nightly-update state for the web interface: $UPDATE_DIR/auto.json {"enabled":..,"at":"HH:MM"}.
write_auto_state() {
  local enabled=false at="04:00" drop="$SYSTEMD_DIR/$TIMER.d/schedule.conf"
  systemctl is-enabled "$TIMER" >/dev/null 2>&1 && enabled=true
  if [ -f "$drop" ]; then
    at="$(sed -n 's/^OnCalendar=\*-\*-\* \([0-9][0-9]:[0-9][0-9]\):00$/\1/p' "$drop" | tail -1)"
    at="${at:-04:00}"
  fi
  mkdir -p "$UPDATE_DIR"
  printf '{"enabled":%s,"at":"%s"}\n' "$enabled" "$at" > "$UPDATE_DIR/auto.json.tmp"
  mv -f "$UPDATE_DIR/auto.json.tmp" "$UPDATE_DIR/auto.json"
  chown "$SERVICE_USER:$SERVICE_USER" "$UPDATE_DIR/auto.json" 2>/dev/null || true
}

# A request from the web interface: {"action":"update"} (or older files: anything else),
# {"action":"enable-auto","at":"HH:MM"} or {"action":"disable-auto"}.
handle_request() {
  local req action at
  req="$(cat "$UPDATE_DIR/request" 2>/dev/null || true)"
  action="$(printf '%s' "$req" | sed -n 's/.*"action"[[:space:]]*:[[:space:]]*"\([a-z-]*\)".*/\1/p')"
  case "$action" in
    enable-auto)
      rm -f "$UPDATE_DIR/request"
      at="$(printf '%s' "$req" | sed -n 's/.*"at"[[:space:]]*:[[:space:]]*"\([0-9][0-9]:[0-9][0-9]\)".*/\1/p')"
      enable_auto "${at:-04:00}" ;;
    disable-auto)
      rm -f "$UPDATE_DIR/request"
      disable_auto ;;
    *) update 0 ;;   # consumes the request itself
  esac
}

status() {
  log "Installed: $(describe)"
  log "Source:    $(git -C "$APP_DIR" remote get-url origin) ($BRANCH)"
  if systemctl is-enabled "$TIMER" >/dev/null 2>&1; then
    log "Nightly updates: on"
    systemctl list-timers "$TIMER" --no-pager 2>/dev/null | sed -n '2p' | sed 's/^/[iptv-manager-update]   next: /'
  else
    log "Nightly updates: off (enable with: iptv-manager-update --enable-auto)"
  fi
  if systemctl is-enabled "$PATH_UNIT" >/dev/null 2>&1; then log "Web updates:     on"; else log "Web updates:     off (run --setup)"; fi
}

usage() { sed -n '2,20p' "$(readlink -f "$0")" | sed 's/^# \{0,1\}//'; }

main() {
  [ "$(id -u)" = 0 ] || [ -n "${IPTV_UPDATE_ALLOW_NONROOT:-}" ] || die "run as root"
  # `pct exec` searches only /bin and /usr/bin, so keep a link there as well as in
  # /usr/local/bin (installs converted before this line existed get it on their next run).
  local bin_link="${BIN_LINK:-/usr/bin/iptv-manager-update}"
  [ -e "$bin_link" ] || ln -sfn "$APP_DIR/proxmox/iptv-manager-update" "$bin_link" 2>/dev/null || true
  load_conf
  case "${1:-}" in
    -h | --help) usage; return 0 ;;
    --setup) setup; log "Systemd units are in place; the web interface can request updates"; return 0 ;;
  esac
  setup
  case "${1:-}" in
    "") if [ -e "$UPDATE_DIR/request" ]; then handle_request; else update 0; fi ;;
    --force) update 1 ;;
    --check) check ;;
    --status) status ;;
    --enable-auto) enable_auto "${2:-}" ;;
    --disable-auto) disable_auto ;;
    *) usage; die "unknown option '$1'" ;;
  esac
}

# Everything above is only definitions, and the exit sits on the same line as the call, so bash
# never reads further from this file once the work starts. An update replacing the script
# mid-run cannot confuse it (git also writes new files instead of editing in place).
main "$@"; exit
